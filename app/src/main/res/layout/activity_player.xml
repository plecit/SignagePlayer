<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Container where dynamic regions (videos, images, webviews) are added -->
    <FrameLayout
        android:id="@+id/layoutContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Splash / Idle Screen (Shown when waiting for auth or downloading initial content) -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/tv_background"
        android:visibility="gone">

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/tv_primary" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_waiting_auth"
            android:textSize="20sp"
            android:textColor="@color/tv_status_waiting"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/splashHardwareKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/tv_focus_ring"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/splashDesc"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/status_waiting_auth_desc"
            android:textSize="15sp"
            android:textColor="@color/tv_text_secondary"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/splashProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <!-- Translucent Status / Toast Overlay for real-time diagnostics -->
    <TextView
        android:id="@+id/tvDiagnosticOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="#AA000000"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:padding="6dp"
        android:visibility="gone" />

</FrameLayout>
