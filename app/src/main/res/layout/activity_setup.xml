<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <!-- Header / Logo -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/tv_primary" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textSize="16sp"
            android:textColor="@color/tv_text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tv_surface"
            android:padding="24dp">

            <!-- CMS URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cms_url_label"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etCmsUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_selector"
                android:hint="@string/cms_url_hint"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="#66FFFFFF"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:inputType="textUri"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

            <!-- Server Key -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_key_label"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etServerKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_selector"
                android:hint="@string/server_key_hint"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="#66FFFFFF"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:inputType="textPassword"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

            <!-- Display Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/display_name_label"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_selector"
                android:hint="@string/display_name_hint"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="#66FFFFFF"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:inputType="text"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

            <!-- Hardware Key Display -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hardware_key_label"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHardwareKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00000000-0000-0000-0000-000000000000"
                android:textColor="@color/tv_focus_ring"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_tv_selector"
                android:text="@string/btn_connect"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true" />

            <!-- Status Indicator -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/tv_status_waiting"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
