<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_primary" />
            <stroke android:width="3dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_primary_variant" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface" />
            <stroke android:width="1dp" android:color="#44FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
